{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "sat-tracker",
  "version-string": "0.1.0",
  "description": "Self-Adaptive beacon Tracking for mobile FSOC coarse alignment (SIH PS 26169)",
  "homepage": "https://github.com/ka1rav6/SAT-satellite-tracker",
  "license": "MIT",
  "supports": "windows | linux",
  "dependencies": [
    {
      "name": "eigen3"
    },
    {
      "name": "doctest"
    },
    {
      "name": "tomlplusplus"
    },
    {
      "name": "nlohmann-json"
    }
  ],
  "builtin-baseline": "a1cae005c39be7b18ba319fced856b68d7276271",
  "features": {
    "video": {
      "description": "MP4 ingest and kernel test oracles (design \u00a78, \u00a716)",
      "dependencies": [
        {
          "name": "opencv4",
          "default-features": false,
          "features": [
            "ffmpeg"
          ]
        }
      ]
    },
    "gui": {
      "description": "The live dashboard (design \u00a712)",
      "dependencies": [
        "glfw3"
      ]
    },
    "ml": {
      "description": "ONNX Runtime for the learned models (design \u00a711, SAT-ML.md)",
      "dependencies": [
        "onnxruntime"
      ]
    }
  }
}
